+export interface DocumentQuote { path: string; text: string }
+
+export const DRAFT_LIMIT = 100000;
+
+/** Build the complete next draft, or reject without discarding either text. */
+export function appendDocumentQuote(draft: string, quote: DocumentQuote): string {
+  if (!quote.text.trim()) return draft;
+  const passage = quote.text.replace(/\r\n?/g, '\n').split('\n').map(line => `> ${line}`).join('\n');
+  const next = `${draft}${draft ? '\n\n' : ''}From ${quote.path}:\n${passage}\n\n`;
+  if (next.length > DRAFT_LIMIT) throw new Error(`Quote not added: the draft would exceed ${DRAFT_LIMIT.toLocaleString('en-US')} characters. Shorten the draft or select a smaller passage.`);
+  return next;
+}
