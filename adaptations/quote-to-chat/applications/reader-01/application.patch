+    assert.ok(repeated.startsWith(first));
+    assert.equal(repeated.match(/From \/docs\/one.md:/g).length, 2);
+    assert.equal(sends.length, 0);
+    await page.reload();
+    await composer.waitFor();
+    assert.equal(await composer.inputValue(), repeated);
+    await page.locator('article p').first().waitFor();
+    // Composer selection cannot become a document quote.
+    await composer.evaluate(el => { el.focus(); el.select(); });
+    await page.waitForTimeout(50);
+    assert.equal(await add.isDisabled(), true);
+    const full = 'x'.repeat(100000);
+    await composer.fill(full);
+    await select(); await add.click();
+    await page.getByRole('alert').filter({ hasText: 'Quote not added' }).waitFor();
+    assert.equal(await composer.inputValue(), full);
+    assert.equal(sends.length, 0);
+    await page.getByRole('link', { name: 'Next', exact: true }).click();
+    await page.getByRole('heading', { name: 'Second', exact: true }).waitFor();
+    assert.equal(await add.isDisabled(), true);
+    await composer.fill('Discuss');
+    await select(); await add.click();
+    assert.match(await composer.inputValue(), /From \/docs\/two.md:\n> Only the current document\./);
+    await select(); await page.getByRole('button', { name: 'Close document' }).click();
+    const beforeReopen = await composer.inputValue();
+    await page.getByRole('button', { name: 'Open document', exact: true }).click();
+    await page.getByRole('heading', { name: 'Reader', exact: true }).waitFor();
+    assert.equal(await add.isDisabled(), true);
+    assert.equal(await composer.inputValue(), beforeReopen);
+    // Exercise a real pointer drag over rendered text, not just synthetic ranges.
+    const paragraph = page.locator('article p').first();
+    await paragraph.scrollIntoViewIfNeeded();
+    const box = await paragraph.boundingBox();
+    await page.mouse.move(box.x + 2, box.y + 12); await page.mouse.down();
+    await page.mouse.move(box.x + Math.min(110, box.width - 2), box.y + 12, { steps: 12 }); await page.mouse.up();
+    await page.waitForFunction(() => ![...document.querySelectorAll('button')].find(b => b.textContent === 'Add to chat').disabled);
+    await add.click();
+    assert.equal(sends.length, 0);
+    const outgoing = await composer.inputValue();
+    await page.getByRole('button', { name: 'Send message', exact: true }).click();
+    await page.waitForFunction(() => document.querySelector('textarea').value === '');
+    await page.waitForTimeout(100);
+    assert.equal(sends.length, 1);
+    assert.ok(JSON.stringify(sends[0]).includes('From /docs/one.md:'));
+    assert.ok(outgoing.includes(beforeReopen));
+    assert.deepEqual(errors, []);
+    console.log(`PASS mocked browser acceptance at ${width}px`);
+    await page.close();
+  }
+} finally {
+  await browser.close();
+  await new Promise(resolve => server.close(resolve));
+}
diff --git a/tests/document-quotes.test.ts b/tests/document-quotes.test.ts
new file mode 100644
index 0000000..a7cd142
--- /dev/null
+++ b/tests/document-quotes.test.ts
@@ -0,0 +1,20 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { appendDocumentQuote, DRAFT_LIMIT } from '../frontend/document-quotes.ts';
+
+const quote = { path: '/notes/reader.md', text: 'First\r\n\r\n  last' };
+test('appends attribution and complete multiline text without changing prior work', () => {
+  assert.equal(appendDocumentQuote('My draft  ', quote), 'My draft  \n\nFrom /notes/reader.md:\n> First\n> \n>   last\n\n');
+});
+test('blank selection is a no-op; repeated quotes append', () => {
+  assert.equal(appendDocumentQuote('Keep', { ...quote, text: '\n  ' }), 'Keep');
+  const first = appendDocumentQuote('', quote);
+  assert.equal(appendDocumentQuote(first, quote), first + '\n\n' + first);
+});
+test('limit accepts exact fit and rejects the whole insertion without truncation', () => {
+  const size = appendDocumentQuote('x', quote).length - 1;
+  const draft = 'x'.repeat(DRAFT_LIMIT - size);
+  assert.equal(appendDocumentQuote(draft, quote).length, DRAFT_LIMIT);
+  assert.throws(() => appendDocumentQuote(draft + 'x', quote), /Quote not added.*100,000/);
+  assert.equal(draft.length, DRAFT_LIMIT - size);
+});
