+export const DRAFT_LIMIT = 100000;
+
+/** Append rendered text without replacing or truncating any existing work. */
+export function appendDocumentQuote(draft: string, path: string, text: string): string {
+  if (!text.trim()) return draft;
+  const quote = `From ${path}:\n${text.replace(/\r\n?/g, '\n').split('\n').map(line => `> ${line}`).join('\n')}\n\n`;
+  const result = draft + (draft && !draft.endsWith('\n\n') ? '\n\n' : '') + quote;
+  if (result.length > DRAFT_LIMIT) throw new Error('Quote not added: the draft would exceed 100,000 characters. Shorten the draft or select a smaller passage.');
+  return result;
+}
