@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { appendDocumentQuote, DRAFT_LIMIT } from '../frontend/document-quotes.ts';
+
+test('attributes rendered multiline passages and preserves the entire draft', () => {
+  assert.equal(appendDocumentQuote('My question', '/docs/reader.md', '  First\r\n\r\nLast'),
+    'My question\n\nFrom /docs/reader.md:\n>   First\n> \n> Last\n\n');
+});
+
+test('ignores blank selections and supports empty drafts and repeated quotes', () => {
+  assert.equal(appendDocumentQuote('Keep me', 'x', ' \n\t'), 'Keep me');
+  const first = appendDocumentQuote('', 'a.md', 'One');
+  assert.equal(first, 'From a.md:\n> One\n\n');
+  assert.equal(appendDocumentQuote(first, 'b.md', 'Two'), first + 'From b.md:\n> Two\n\n');
+});
+
+test('accepts the exact draft limit and rejects overflow without truncation', () => {
+  const quote = appendDocumentQuote('', 'x', 'text');
+  const existing = 'a'.repeat(DRAFT_LIMIT - quote.length - 2);
+  assert.equal(appendDocumentQuote(existing, 'x', 'text').length, DRAFT_LIMIT);
+  assert.throws(() => appendDocumentQuote(existing + 'a', 'x', 'text'), /exceed 100,000/);
+  assert.equal(existing.length, DRAFT_LIMIT - quote.length - 2);
+});
