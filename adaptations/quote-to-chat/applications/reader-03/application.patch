+// Optional isolated acceptance check after `make build` (no backend/provider).
+// npm install --no-save --package-lock=false --prefix .local/quote-browser playwright@1.48.2
+// PLAYWRIGHT_MODULE=../.local/quote-browser/node_modules/playwright/index.mjs node tests/quote-browser.mjs
+import assert from 'node:assert/strict';
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { resolve, extname } from 'node:path';
+const { chromium } = await import(process.env.PLAYWRIGHT_MODULE || 'playwright');
+const root = resolve('dist');
+const server = createServer(async (req, res) => {
+  try {
+    const file = resolve(root, '.' + new URL(req.url, 'http://localhost').pathname.replace(/\/$/, '/index.html'));
+    if (!file.startsWith(root + '/')) throw new Error('Invalid path');
+    res.setHeader('Content-Type', ({ '.html': 'text/html', '.js': 'text/javascript', '.css': 'text/css' })[extname(file)] || 'text/plain');
+    res.end(await readFile(file));
+  } catch { res.writeHead(404); res.end(); }
+});
+await new Promise(done => server.listen(0, '127.0.0.1', done));
+const browser = await chromium.launch({ headless: true });
+try {
+  for (const width of [1440, 390]) {
+    const page = await browser.newPage({ viewport: { width, height: 1000 } });
+    const sent = [];
+    const errors = [];
+    page.on('pageerror', error => errors.push(error.message));
+    await page.addInitScript(() => {
+      sessionStorage.setItem('open-document', 'reader.md');
+      window.snapshot = { messages: [], busy: false, error: null, activity: '', steering: [], context: null, sessionId: 'fixture' };
+      window.EventSource = class {
+        constructor() { window.events = this; setTimeout(() => this.onmessage?.({ data: JSON.stringify(window.snapshot) }), 0); }
+        close() {}
+      };
+    });
+    await page.route('**/api/**', async route => {
+      const url = new URL(route.request().url());
+      let result = {};
+      if (url.pathname === '/api/documents/content') {
+        const second = url.searchParams.get('path') === 'other.md';
+        result = { path: second ? '/canonical/other.md' : '/canonical/reader.md', content: second ? '# Other\n\nDifferent passage.' : '# Reader\n\nA passage worth discussing.\n\n[Other](other.md)' };
+      } else if (url.pathname === '/api/documents/resolve') result = { path: 'other.md' };
+      else if (url.pathname === '/api/chat') { sent.push(route.request().postDataJSON()); result = { accepted: true }; }
+      else throw new Error(`Unexpected API: ${url.pathname}`);
+      await route.fulfill({ json: result });
+    });
+    await page.goto(`http://127.0.0.1:${server.address().port}`);
+    const composer = page.getByRole('textbox', { name: 'Message Pi' });
+    const action = page.getByRole('button', { name: 'Add to chat', exact: true });
+    await composer.fill('My existing question');
+    async function select() {
+      await page.locator('.markdown-document').scrollIntoViewIfNeeded();
+      await page.locator('.markdown-document p').first().evaluate(element => {
+        const range = document.createRange(); range.selectNodeContents(element);
+        const selection = window.getSelection(); selection.removeAllRanges(); selection.addRange(range);
+      });
+      await action.waitFor();
+    }
+    await page.locator('.markdown-document').scrollIntoViewIfNeeded();
+    const textRect = await page.locator('.markdown-document p').first().evaluate(element => {
+      const range = document.createRange(); range.selectNodeContents(element);
+      const rect = range.getBoundingClientRect();
+      return { x: rect.x, y: rect.y, width: rect.width, height: rect.height };
+    });
+    await page.mouse.move(textRect.x + 1, textRect.y + textRect.height / 2);
+    await page.mouse.down();
+    await page.mouse.move(textRect.x + textRect.width - 1, textRect.y + textRect.height / 2, { steps: 12 });
+    await page.mouse.up();
+    await action.waitFor();
+    assert.equal(await composer.inputValue(), 'My existing question');
+    const rect = await page.locator('.markdown-document p').first().boundingBox();
+    const buttonRect = await action.boundingBox();
+    assert.ok(Math.min(Math.abs(buttonRect.y - rect.y), Math.abs(buttonRect.y - (rect.y + rect.height))) < 60);
+    assert.ok(buttonRect.x >= 0 && buttonRect.x + buttonRect.width <= width);
+    await page.keyboard.press('Escape');
+    await action.waitFor({ state: 'hidden' });
+    assert.equal(await composer.inputValue(), 'My existing question');
+    await select();
+    await page.getByRole('link', { name: 'Other', exact: true }).focus();
+    await page.keyboard.press('Tab');
+    assert.equal(await action.evaluate(el => el === document.activeElement), true);
+    await page.keyboard.press('Enter');
+    assert.equal(await composer.inputValue(), 'My existing question\n\nFrom /canonical/reader.md:\n> A passage worth discussing.\n\n');
+    assert.equal(await composer.evaluate(el => el === document.activeElement), true);
+    assert.equal(sent.length, 0);
+    const first = await composer.inputValue();
+    await page.reload(); await composer.waitFor();
+    assert.equal(await composer.inputValue(), first);
+    await page.evaluate(() => { window.snapshot.busy = true; window.events.onmessage({ data: JSON.stringify(window.snapshot) }); });
+    await select(); await action.click();
+    assert.equal(await composer.inputValue(), first + 'From /canonical/reader.md:\n> A passage worth discussing.\n\n');
+    assert.equal(sent.length, 0);
+    await composer.fill('x'.repeat(99995));
+    await select(); await action.click();
+    assert.match(await page.getByRole('alert').innerText(), /exceed 100,000/);
+    assert.equal((await composer.inputValue()).length, 99995);
+    assert.equal(sent.length, 0);
+    await page.getByRole('button', { name: 'Dismiss quote' }).click();
+    await action.waitFor({ state: 'hidden' });
+    await composer.fill('Ready');
+    await composer.evaluate(el => { el.focus(); el.select(); });
+    assert.equal(await action.count(), 0);
+    await select();
+    await page.getByRole('link', { name: 'Other', exact: true }).click();
+    await page.getByRole('heading', { name: 'Other', exact: true }).waitFor();
+    await action.waitFor({ state: 'hidden' });
+    assert.equal(await composer.inputValue(), 'Ready');
+    await select(); await action.click();
+    assert.equal(await composer.inputValue(), 'Ready\n\nFrom /canonical/other.md:\n> Different passage.\n\n');
+    await select();
+    await page.getByRole('button', { name: 'Close document' }).click();
+    await action.waitFor({ state: 'hidden' });
+    assert.equal(sent.length, 0);
+    const finalDraft = await composer.inputValue();
+    await page.getByRole('button', { name: 'Steer Pi', exact: true }).click();
+    await page.waitForFunction(() => document.querySelector('textarea').value === '');
+    await new Promise(done => setTimeout(done, 100));
+    assert.equal(sent.length, 1);
+    assert.equal(sent[0].message, finalDraft);
+    assert.deepEqual(errors, []);
+    console.log(`PASS ${width}px: selection, placement, keyboard, dismiss, preservation, persistence, busy, overflow, navigation, close, explicit send`);
+    await page.close();
+  }
+} finally { await browser.close(); await new Promise(done => server.close(done)); }
