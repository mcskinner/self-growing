+// Build first. Run with PLAYWRIGHT_MODULE pointing to an installed playwright module if needed.
+// Uses only a static production build and mocked APIs; never starts the backend.
+import assert from 'node:assert/strict';
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { resolve, extname } from 'node:path';
+const { chromium } = await import(process.env.PLAYWRIGHT_MODULE || 'playwright');
+const root = resolve('dist');
+const server = createServer(async (req, res) => {
+  try {
+    const path = resolve(root, '.' + new URL(req.url, 'http://fixture').pathname);
+    if (!path.startsWith(root + '/') && path !== root) throw new Error('Invalid path');
+    res.setHeader('Content-Type', ({ '.js': 'text/javascript', '.css': 'text/css' })[extname(path)] || 'text/html');
+    res.end(await readFile(path === root ? root + '/index.html' : path));
+  } catch { res.writeHead(404); res.end(); }
+});
+await new Promise(done => server.listen(0, '127.0.0.1', done));
+const browser = await chromium.launch({ headless: true });
+try {
+  for (const width of [1280, 390]) {
+    const page = await browser.newPage({ viewport: { width, height: 900 } });
+    const sent = [];
+    await page.addInitScript(() => {
+      sessionStorage.setItem('open-document', '/docs/first.md');
+      window.fixtureState = { messages: [], busy: false, error: null, activity: '', steering: [], context: null, sessionId: 'fixture' };
+      window.EventSource = class {
+        constructor() { window.emitState = () => this.onmessage?.({ data: JSON.stringify(window.fixtureState) }); setTimeout(window.emitState, 0); }
+        close() {}
+      };
+    });
+    await page.route('**/api/**', async route => {
+      const url = new URL(route.request().url());
+      if (url.pathname === '/api/documents/content') {
+        const path = url.searchParams.get('path');
+        await route.fulfill({ json: { path, content: '# Reader\n\nA selected passage to discuss.\n\n[Next](second.md)' } });
+      } else if (url.pathname === '/api/documents/resolve') {
+        await route.fulfill({ json: { path: '/docs/second.md' } });
+      } else if (url.pathname === '/api/chat') {
+        sent.push(route.request().postDataJSON());
+        await route.fulfill({ json: { ok: true } });
+      } else throw new Error(`Unexpected API call ${url}`);
+    });
+    await page.goto(`http://127.0.0.1:${server.address().port}`);
+    const composer = page.getByRole('textbox', { name: 'Message Pi' });
+    const action = page.getByRole('button', { name: 'Add quote to chat' });
+    const select = async () => {
+      await page.locator('.markdown-document p').first().scrollIntoViewIfNeeded();
+      await page.evaluate(() => {
+        const range = document.createRange();
+        range.selectNodeContents(document.querySelector('.markdown-document p'));
+        window.getSelection().removeAllRanges(); window.getSelection().addRange(range);
+      });
+      await action.waitFor();
+    };
+    await composer.fill('Prior work');
+    await select();
+    assert.equal(await composer.inputValue(), 'Prior work');
+    const fit = await action.evaluate(button => {
+      const box = button.getBoundingClientRect();
+      const range = document.createRange(); range.selectNodeContents(button.querySelector('span'));
+      const rects = [...range.getClientRects()];
+      return rects.length === 1 && rects[0].left >= box.left && rects[0].right <= box.right &&
+        rects[0].top >= box.top && rects[0].bottom <= box.bottom && box.left >= 0 && box.right <= innerWidth;
+    });
+    assert.ok(fit, `single-line label fits its control at ${width}px`);
+    await page.keyboard.press('Escape');
+    assert.equal(await action.count(), 0);
+    assert.equal(await composer.inputValue(), 'Prior work');
+    await select();
+    await page.locator('.document-toolbar strong').click();
+    assert.equal(await action.count(), 0);
+    assert.equal(await composer.inputValue(), 'Prior work');
+    await page.evaluate(() => {
+      const range = document.createRange();
+      const text = document.querySelector('.markdown-document p').firstChild;
+      range.setStart(text, 1); range.setEnd(text, 2); // the space after "A"
+      window.getSelection().removeAllRanges(); window.getSelection().addRange(range);
+    });
+    await page.evaluate(() => new Promise(done => requestAnimationFrame(done)));
+    assert.equal(await action.count(), 0, 'blank selections have no action');
+    await select();
+    await action.click();
+    const quoted = 'Prior work\n\nFrom /docs/first.md:\n> A selected passage to discuss.';
+    assert.equal(await composer.inputValue(), quoted);
+    // Check after React has rendered, not just synchronously inside the click handler.
+    await page.evaluate(() => new Promise(done => requestAnimationFrame(() => requestAnimationFrame(done))));
+    assert.ok(await composer.evaluate(el => document.activeElement === el && el.selectionStart === el.value.length && el.selectionEnd === el.value.length));
+    await page.keyboard.type(' Continued');
+    assert.equal(await composer.inputValue(), quoted + ' Continued');
+    assert.equal(sent.length, 0);
+    await page.evaluate(() => { window.fixtureState.busy = true; window.emitState(); });
+    await page.getByRole('button', { name: 'Stop Pi and pause unsent messages' }).waitFor();
+    await select();
+    // Accessible keyboard activation also works.
+    await action.focus(); await page.keyboard.press('Enter');
+    assert.equal(await composer.inputValue(), quoted + ' Continued\n\nFrom /docs/first.md:\n> A selected passage to discuss.');
+    assert.equal(sent.length, 0, 'busy quoting must not steer');
+    const saved = await composer.inputValue();
+    await page.reload();
+    await composer.waitFor();
+    assert.equal(await composer.inputValue(), saved);
+    await composer.fill('x'.repeat(99990));
+    await select(); await action.click();
+    await page.getByRole('alert').filter({ hasText: '100,000' }).waitFor();
+    assert.equal((await composer.inputValue()).length, 99990);
+    await composer.fill('Keep');
+    await select();
+    await page.getByRole('link', { name: 'Next', exact: true }).click();
+    await page.locator('.document-toolbar strong').filter({ hasText: '/docs/second.md' }).waitFor();
+    assert.equal(await action.count(), 0);
+    assert.equal(await composer.inputValue(), 'Keep');
+    await select(); await action.click();
+    assert.equal(await composer.inputValue(), 'Keep\n\nFrom /docs/second.md:\n> A selected passage to discuss.');
+    await select(); await page.getByRole('button', { name: 'Close document' }).click();
+    assert.equal(await action.count(), 0);
+    assert.equal(sent.length, 0);
+    await page.getByRole('button', { name: 'Send message', exact: true }).click();
+    await page.waitForFunction(() => document.querySelector('textarea').value === '');
+    await new Promise(done => setTimeout(done, 100));
+    assert.equal(sent.length, 1);
+    assert.equal(sent[0].message, 'Keep\n\nFrom /docs/second.md:\n> A selected passage to discuss.');
+    await page.close();
+    console.log(`PASS quote-to-chat browser acceptance at ${width}px`);
+  }
+} finally { await browser.close(); await new Promise(done => server.close(done)); }
