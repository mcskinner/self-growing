diff --git a/tests/document-quotes.test.ts b/tests/document-quotes.test.ts
new file mode 100644
index 0000000..90ee566
--- /dev/null
+++ b/tests/document-quotes.test.ts
@@ -0,0 +1,18 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { appendDocumentQuote, DRAFT_LIMIT } from '../frontend/document-quotes.ts';
+
+test('quotes preserve drafts and attribute rendered multiline passages', () => {
+  assert.equal(appendDocumentQuote('Existing work', '/notes.md', '  First\r\n\r\nSecond'),
+    'Existing work\n\nFrom /notes.md:\n>   First\n> \n> Second\n\n');
+});
+test('blank selections do nothing and repeated quotes append', () => {
+  assert.equal(appendDocumentQuote('work', 'a', ' \n'), 'work');
+  const first = appendDocumentQuote('', 'a', 'one');
+  assert.equal(appendDocumentQuote(first, 'b', 'two'), first + '\n\nFrom b:\n> two\n\n');
+});
+test('combined draft limit rejects without truncation', () => {
+  const quote = appendDocumentQuote('', 'a', 'one');
+  assert.equal(appendDocumentQuote('x'.repeat(DRAFT_LIMIT - quote.length - 2), 'a', 'one').length, DRAFT_LIMIT);
+  assert.throws(() => appendDocumentQuote('x'.repeat(DRAFT_LIMIT), 'a', 'one'), /Quote not added/);
+});
