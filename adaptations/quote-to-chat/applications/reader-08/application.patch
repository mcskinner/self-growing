+export const DRAFT_LIMIT = 100000;
+
+export function appendDocumentQuote(draft: string, path: string, text: string): string {
+  if (!text.trim()) return draft;
+  const quote = `From ${path}:\n${text.replace(/\r\n?/g, '\n').split('\n').map(line => `> ${line}`).join('\n')}\n\n`;
+  const result = draft + (draft ? '\n\n' : '') + quote;
+  if (result.length > DRAFT_LIMIT) throw new Error('Quote not added: the combined draft exceeds the 100,000-character limit. Shorten the draft or select a smaller passage.');
+  return result;
+}
+
+export interface QuoteComposer { append: (path: string, text: string) => string | null }
