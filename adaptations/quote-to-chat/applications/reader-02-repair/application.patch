diff --git a/tests/quote-composer.browser.mjs b/tests/quote-composer.browser.mjs
new file mode 100644
index 0000000..854248d
--- /dev/null
+++ b/tests/quote-composer.browser.mjs
@@ -0,0 +1,107 @@
+// Run after `make build`:
+// PLAYWRIGHT_MODULE=/absolute/path/to/playwright/index.mjs node --test tests/quote-composer.browser.mjs
+// Uses only built static assets and mocked APIs; no backend or provider.
+import assert from 'node:assert/strict';
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { test } from 'node:test';
+
+const { chromium } = await import(process.env.PLAYWRIGHT_MODULE || 'playwright');
+
+test('quote action fits and leaves the committed composer ready to type', async () => {
+  const server = createServer(async (req, res) => {
+    try {
+      const path = new URL(req.url, 'http://localhost').pathname;
+      const file = path === '/' ? '/index.html' : path;
+      if (!/^\/(index\.html|assets\/[\w.-]+)$/.test(file)) throw new Error('Unknown asset');
+      const body = await readFile(new URL(`../dist${file}`, import.meta.url));
+      res.setHeader('Content-Type', file.endsWith('.js') ? 'text/javascript' : file.endsWith('.css') ? 'text/css' : 'text/html');
+      res.end(body);
+    } catch { res.writeHead(404).end(); }
+  });
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  let browser;
+  try {
+    browser = await chromium.launch(process.env.CHROMIUM_PATH ? { executablePath: process.env.CHROMIUM_PATH } : {});
+    for (const width of [1280, 390]) {
+      for (const activation of ['pointer', 'Enter', 'Space']) {
+        const page = await browser.newPage({ viewport: { width, height: 900 } });
+        const posts = [];
+        await page.addInitScript(() => {
+          sessionStorage.setItem('open-document', 'fixture.md');
+          window.EventSource = class {
+            constructor() {
+              setTimeout(() => this.onmessage?.({ data: JSON.stringify({
+                messages: [], busy: false, error: null, activity: '', steering: [], context: null, sessionId: 'fixture-chat',
+              }) }), 0);
+            }
+            close() {}
+          };
+        });
+        await page.route('**/api/**', async route => {
+          const request = route.request();
+          if (request.method() === 'POST') posts.push(request.url());
+          if (request.url().includes('/documents/content?')) {
+            await route.fulfill({ json: { path: '/fixture.md', content: '# Fixture\n\nA selected passage for discussion.' } });
+          } else if (request.url().endsWith('/api/chat')) {
+            await route.fulfill({ json: {} });
+          } else {
+            await route.abort();
+          }
+        });
+        await page.goto(`http://127.0.0.1:${server.address().port}`);
+        const composer = page.getByRole('textbox', { name: 'Message Pi' });
+        await composer.fill('Existing draft');
+        const selectPassage = async () => {
+          await page.locator('.markdown-document p').scrollIntoViewIfNeeded();
+          await page.locator('.markdown-document p').evaluate(element => {
+            const range = document.createRange();
+            range.selectNodeContents(element);
+            window.getSelection().removeAllRanges();
+            window.getSelection().addRange(range);
+          });
+          await page.getByRole('button', { name: 'Add to chat' }).waitFor();
+        };
+        await selectPassage();
+        await page.keyboard.press('Escape');
+        assert.equal(await composer.inputValue(), 'Existing draft');
+        await selectPassage();
+        const action = page.getByRole('button', { name: 'Add to chat' });
+        const fits = await action.evaluate(element => {
+          const rect = element.getBoundingClientRect();
+          const range = document.createRange();
+          range.selectNodeContents(element);
+          const text = range.getBoundingClientRect();
+          return rect.width > 36 && element.scrollWidth <= element.clientWidth &&
+            text.left >= rect.left && text.right <= rect.right && text.top >= rect.top && text.bottom <= rect.bottom &&
+            rect.left >= 0 && rect.right <= innerWidth && rect.top >= 0 && rect.bottom <= innerHeight;
+        });
+        assert.ok(fits, `${width}/${activation}: readable action inside viewport`);
+        if (activation === 'pointer') await action.click();
+        else {
+          await action.focus();
+          await page.keyboard.press(activation);
+        }
+        const expected = 'Existing draft\n\nFrom /fixture.md:\n> A selected passage for discussion.\n\n';
+        await page.waitForFunction(expected => {
+          const element = document.querySelector('textarea');
+          return element.value === expected && document.activeElement === element &&
+            element.selectionStart === expected.length && element.selectionEnd === expected.length;
+        }, expected);
+        // Include a later frame so an asynchronous selection update cannot undo it.
+        await page.evaluate(() => new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve))));
+        assert.deepEqual(await composer.evaluate(element => [document.activeElement === element, element.selectionStart, element.selectionEnd]),
+          [true, expected.length, expected.length]);
+        await page.keyboard.type('Continue typing');
+        assert.equal(await composer.inputValue(), `${expected}Continue typing`);
+        assert.deepEqual(posts, [], 'quoting and typing must not send');
+        assert.ok(await page.evaluate(expected => Object.values(sessionStorage).includes(expected), `${expected}Continue typing`),
+          'the edited quote remains in the saved draft');
+        await page.close();
+      }
+    }
+  } finally {
+    await browser?.close();
+    await new Promise(resolve => server.close(resolve));
+  }
+});
