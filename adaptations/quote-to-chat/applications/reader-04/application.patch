@@ -0,0 +1,11 @@
+export interface DocumentQuote { path: string; text: string }
+
+export const DRAFT_LIMIT = 100000;
+
+export function appendQuote(draft: string, quote: DocumentQuote): string {
+  if (!quote.text.trim()) return draft;
+  const passage = quote.text.replace(/\r\n?/g, '\n').split('\n').map(line => `> ${line}`).join('\n');
+  const combined = `${draft}${draft ? '\n\n' : ''}From ${quote.path}:\n${passage}\n\n`;
+  if (combined.length > DRAFT_LIMIT) throw new Error('Quote not added: the draft would exceed 100,000 characters. Shorten the draft or select a smaller passage.');
+  return combined;
+}
