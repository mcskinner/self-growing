@@ -0,0 +1,20 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { appendQuote, DRAFT_LIMIT } from '../frontend/document-quotes.ts';
+
+test('quotes append attributed editable text without losing draft whitespace', () => {
+  assert.equal(appendQuote('My draft  ', { path: '/docs/a.md', text: ' first\r\n\r\nlast' }),
+    'My draft  \n\nFrom /docs/a.md:\n>  first\n> \n> last\n\n');
+});
+test('blank selections do nothing; repeated quotes append', () => {
+  assert.equal(appendQuote('draft', { path: 'a.md', text: ' \n ' }), 'draft');
+  const quote = { path: 'a.md', text: 'passage' };
+  const first = appendQuote('', quote);
+  assert.equal(appendQuote(first, quote), first + '\n\n' + first);
+});
+test('overflow is rejected whole, including attribution and spacing', () => {
+  const quote = { path: 'a.md', text: 'passage' };
+  const size = appendQuote('', quote).length + 2;
+  assert.equal(appendQuote('x'.repeat(DRAFT_LIMIT - size), quote).length, DRAFT_LIMIT);
+  assert.throws(() => appendQuote('x'.repeat(DRAFT_LIMIT - size + 1), quote), /Quote not added/);
+});
