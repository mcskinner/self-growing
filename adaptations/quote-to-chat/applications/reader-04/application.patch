+// Run after npm run build; requires an optional local playwright installation.
+// Uses only a static build server and mocked APIs; never contacts a backend/provider.
+import { chromium } from 'playwright';
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import assert from 'node:assert/strict';
+
+const server = createServer(async (req, res) => {
+  try {
+    const path = req.url === '/' ? '/index.html' : req.url;
+    if (!/^\/(assets\/[\w.-]+|index.html)$/.test(path)) { res.writeHead(404).end(); return; }
+    res.setHeader('Content-Type', path.endsWith('.js') ? 'text/javascript' : path.endsWith('.css') ? 'text/css' : 'text/html');
+    res.end(await readFile(new URL(`../dist${path}`, import.meta.url)));
+  } catch { res.writeHead(404).end(); }
+});
+await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+let browser;
+try {
+  browser = await chromium.launch({ executablePath: process.env.CHROME_PATH || '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome', headless: true });
+  for (const width of [1440, 390]) {
+    const page = await browser.newPage({ viewport: { width, height: 1000 } });
+    const sent = [];
+    await page.addInitScript(() => {
+      window.EventSource = class {
+        constructor() {
+          window.emitState = busy => this.onmessage?.({ data: JSON.stringify({ messages: [], busy, error: null, activity: '', steering: [], context: null, sessionId: 'fixture' }) });
+          setTimeout(() => window.emitState(false), 0);
+        }
+        close() {}
+      };
+    });
+    await page.route('**/api/**', route => {
+      const url = new URL(route.request().url());
+      let data;
+      if (url.pathname === '/api/documents/pick') data = { path: 'docs/one.md' };
+      else if (url.pathname === '/api/documents/content') data = { path: url.searchParams.get('path'), content: '# Fixture\n\nA passage worth discussing.\n\n[Next](two.md)' };
+      else if (url.pathname === '/api/documents/resolve') data = { path: 'docs/two.md' };
+      else if (url.pathname === '/api/chat') { sent.push(JSON.parse(route.request().postData()).message); data = {}; }
+      else throw new Error(`Unexpected API: ${url.pathname}`);
+      return route.fulfill({ json: data });
+    });
+    await page.goto(`http://127.0.0.1:${server.address().port}`);
+    const composer = page.getByRole('textbox', { name: 'Message Pi' });
+    const action = page.getByRole('button', { name: 'Add to chat', exact: true });
+    await composer.fill('Existing work');
+    await page.getByRole('button', { name: 'Open document', exact: true }).click();
+    async function select() {
+      await page.locator('.markdown-document p').first().scrollIntoViewIfNeeded();
+      await page.locator('.markdown-document p').first().evaluate(el => {
+        const range = document.createRange(); range.selectNodeContents(el);
+        const selection = window.getSelection(); selection.removeAllRanges(); selection.addRange(range);
+      });
+      await action.waitFor({ state: 'visible' });
+    }
+    await page.locator('.markdown-document p').first().scrollIntoViewIfNeeded();
+    const passageBox = await page.locator('.markdown-document p').first().boundingBox();
+    await page.mouse.move(passageBox.x + 2, passageBox.y + passageBox.height / 2);
+    await page.mouse.down();
+    await page.mouse.move(passageBox.x + 140, passageBox.y + passageBox.height / 2, { steps: 12 });
+    await page.mouse.up();
+    await action.waitFor({ state: 'visible' });
+    assert.equal(await composer.inputValue(), 'Existing work');
+    await select();
+    // Check actual label glyph geometry, not just button visibility/bounds.
+    assert.ok(await action.evaluate(button => {
+      const rect = button.getBoundingClientRect();
+      const range = document.createRange(); range.selectNodeContents(button);
+      const lines = [...range.getClientRects()];
+      const style = getComputedStyle(button);
+      return lines.length === 1 && lines[0].width > 0 && lines.every(line =>
+        line.left >= rect.left + parseFloat(style.paddingLeft) - 1 && line.right <= rect.right - parseFloat(style.paddingRight) + 1 &&
+        line.top >= rect.top && line.bottom <= rect.bottom) && rect.left >= 0 && rect.right <= innerWidth && rect.top >= 0 && rect.bottom <= innerHeight;
+    }), `label fits at ${width}px`);
+    await page.keyboard.press('Escape');
+    await action.waitFor({ state: 'hidden' });
+    assert.equal(await composer.inputValue(), 'Existing work');
+    await select();
+    await action.focus(); await page.keyboard.press('Enter');
+    await composer.waitFor({ state: 'visible' });
+    assert.equal(await composer.inputValue(), 'Existing work\n\nFrom docs/one.md:\n> A passage worth discussing.\n\n');
+    assert.equal(await composer.evaluate(el => el === document.activeElement), true);
+    assert.equal(sent.length, 0);
+    const first = await composer.inputValue();
+    await page.reload();
+    assert.equal(await composer.inputValue(), first);
+    await page.evaluate(() => window.emitState(true));
+    await page.locator('.activity').waitFor();
+    await page.waitForFunction(() => document.querySelector('.document-scroll')?.getAttribute('aria-busy') === 'false');
+    await select(); await action.click();
+    const repeated = await composer.inputValue();
+    assert.ok(repeated.startsWith(first) && repeated.length > first.length);
+    assert.equal(sent.length, 0);
+    await composer.fill('x'.repeat(99999));
+    await select(); await action.click();
+    await page.getByRole('alert').filter({ hasText: 'Quote not added' }).waitFor();
+    assert.equal((await composer.inputValue()).length, 99999);
+    await composer.fill('Keep');
+    await select();
+    await page.getByRole('link', { name: 'Next' }).focus();
+    await page.keyboard.press('Enter');
+    await action.waitFor({ state: 'hidden' });
+    await page.waitForFunction(() => document.querySelector('.document-toolbar strong')?.textContent === 'docs/two.md' && document.querySelector('.document-scroll')?.getAttribute('aria-busy') === 'false');
+    await select(); await action.click();
+    assert.match(await composer.inputValue(), /From docs\/two.md:/);
+    await select();
+    await page.getByRole('button', { name: 'Close document' }).click();
+    await action.waitFor({ state: 'hidden' });
+    const final = await composer.inputValue();
+    assert.equal(sent.length, 0);
+    await composer.press('Enter');
+    await page.waitForFunction(() => document.querySelector('textarea').value === '');
+    await new Promise(resolve => setTimeout(resolve, 100));
+    assert.deepEqual(sent, [final]);
+    console.log(`PASS ${width}px: label fit, explicit insertion, keyboard, dismissal, focus, persistence, busy/no-send, repeat, overflow, navigation/close, explicit send`);
+    await page.close();
+  }
+} finally {
+  await browser?.close();
+  await new Promise(resolve => server.close(resolve));
+}
