+++ b/tests/document-quotes.test.ts
@@ -0,0 +1,17 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { appendDocumentQuote, DRAFT_LIMIT } from '../frontend/document-quotes.ts';
+
+test('quotes preserve draft, attribution, indentation and blank lines', () => {
+  assert.equal(appendDocumentQuote('Existing work ', { path: '/docs/a.md', text: '  One\r\n\r\nTwo' }),
+    'Existing work \n\nFrom /docs/a.md:\n>   One\n> \n> Two\n\n');
+});
+test('blank selections are ignored and repeated quotes append', () => {
+  assert.equal(appendDocumentQuote('draft', { path: 'a', text: ' \n' }), 'draft');
+  const quote = { path: 'a', text: 'One' };
+  const once = appendDocumentQuote('', quote);
+  assert.equal(appendDocumentQuote(once, quote), once + '\n\n' + once);
+});
+test('overflow rejects the whole insertion', () => {
+  assert.throws(() => appendDocumentQuote('x'.repeat(DRAFT_LIMIT), { path: 'a', text: 'One' }), /Quote not added/);
+});
