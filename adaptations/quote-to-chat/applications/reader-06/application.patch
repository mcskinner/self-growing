+const browser = await chromium.launch({ headless: true, ...(process.env.CHROME_PATH ? { executablePath: process.env.CHROME_PATH } : {}) });
+try {
+  for (const width of [1440, 390]) {
+    const page = await browser.newPage({ viewport: { width, height: 900 } });
+    const sent = [];
+    await page.addInitScript(() => {
+      sessionStorage.setItem('open-document', '/docs/one.md');
+      window.EventSource = class {
+        constructor() {
+          window.fixtureState = { messages: [], busy: false, error: null, activity: '', steering: [], context: null, sessionId: 'fixture' };
+          window.snapshot = patch => {
+            Object.assign(window.fixtureState, patch);
+            this.onmessage?.({ data: JSON.stringify(window.fixtureState) });
+          };
+          setTimeout(() => window.snapshot({}), 0);
+        }
+        close() {}
+      };
+    });
+    await page.route('**/*', async route => {
+      const url = new URL(route.request().url());
+      if (url.pathname === '/api/chat') { sent.push(JSON.parse(route.request().postData()).message); return route.fulfill({ json: {} }); }
+      if (url.pathname === '/api/documents/content') return route.fulfill({ json: { path: url.searchParams.get('path'), content: '# Reader\n\nA passage worth discussing.\n\n[Next](two.md)' } });
+      if (url.pathname === '/api/documents/resolve') return route.fulfill({ json: { path: '/docs/two.md' } });
+      if (url.pathname.startsWith('/api/')) throw new Error(`Unexpected API ${url.pathname}`);
+      const file = url.pathname === '/' ? 'index.html' : url.pathname.slice(1);
+      return route.fulfill({ body: await readFile(new URL(`../dist/${file}`, import.meta.url)), contentType: file.endsWith('.js') ? 'application/javascript' : file.endsWith('.css') ? 'text/css' : 'text/html' });
+    });
+    await page.goto('https://quote.fixture/');
+    const input = page.getByRole('textbox', { name: 'Message Pi' });
+    const action = page.getByRole('button', { name: 'Add to chat', exact: true });
+    async function select() {
+      await page.waitForTimeout(150); // Let composer autosize and narrow-layout scrolling settle.
+      await page.locator('.markdown-document p').first().scrollIntoViewIfNeeded();
+      await page.waitForTimeout(150);
+      await page.locator('.markdown-document p').first().evaluate(el => {
+        const range = document.createRange(); range.selectNodeContents(el);
+        const selection = getSelection(); selection.removeAllRanges(); selection.addRange(range);
+        document.dispatchEvent(new Event('selectionchange'));
