+        [true, (await input.inputValue()).length, (await input.inputValue()).length, (await input.inputValue()).length]);
+    }
+    await input.fill('Prior work');
+    await page.locator('.markdown-document p').first().scrollIntoViewIfNeeded();
+    await page.waitForTimeout(150);
+    const passage = await page.locator('.markdown-document p').first().boundingBox();
+    await page.mouse.move(passage.x + 1, passage.y + 12);
+    await page.mouse.down();
+    await page.mouse.move(passage.x + 90, passage.y + 12, { steps: 12 });
+    await page.mouse.up();
+    await action.waitFor();
+    assert.equal(await input.inputValue(), 'Prior work');
+    await page.keyboard.press('Escape');
+    await input.selectText();
+    assert.equal(await action.count(), 0, 'composer selection is not a document quote');
+    await select();
+    assert.equal(await input.inputValue(), 'Prior work');
+    assert.equal(await action.evaluate(el => {
+      const range = document.createRange(); range.selectNodeContents(el);
+      const lines = [...range.getClientRects()]; const b = el.getBoundingClientRect();
+      return lines.length === 1 && lines[0].left >= b.left && lines[0].right <= b.right && lines[0].top >= b.top && lines[0].bottom <= b.bottom && b.left >= 0 && b.right <= innerWidth;
+    }), true, `single-line label fits at ${width}px`);
+    await page.keyboard.press('Escape');
+    assert.equal(await action.count(), 0);
+    assert.equal(await input.inputValue(), 'Prior work');
+    await select();
+    await action.focus(); await page.keyboard.press('Enter');
+    await page.waitForFunction(() => document.querySelector('textarea').value.includes('From /docs/one.md:'));
+    await focusAtEnd();
