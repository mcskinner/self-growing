diff --git a/frontend/quote.ts b/frontend/quote.ts
new file mode 100644
index 0000000..4d26e50
--- /dev/null
+++ b/frontend/quote.ts
@@ -0,0 +1,8 @@
+export const DRAFT_LIMIT = 100000;
+
+export function appendQuote(draft: string, path: string, text: string): string | null {
+  if (!text.trim()) return null;
+  const quote = `From ${path}:\n${text.split('\n').map(line => `> ${line}`).join('\n')}`;
+  const next = draft + (draft ? '\n\n' : '') + quote;
+  return next.length <= DRAFT_LIMIT ? next : null;
+}
