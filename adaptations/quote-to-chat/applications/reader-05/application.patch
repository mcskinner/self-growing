@@ -0,0 +1,123 @@
+// Run after npm run build. Requires Playwright; all APIs are mocked, no backend/provider.
+// QUOTE_PLAYWRIGHT may name an absolute path to Playwright's index.mjs.
+// QUOTE_CHROMIUM may name an existing Chromium executable.
+import assert from 'node:assert/strict';
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { resolve, extname } from 'node:path';
+const { chromium } = await import(process.env.QUOTE_PLAYWRIGHT || 'playwright');
+const server = createServer(async (req, res) => {
+  try {
+    const path = resolve('dist', req.url === '/' ? 'index.html' : `.${req.url}`);
+    if (!path.startsWith(resolve('dist') + '/')) throw new Error('Outside fixture');
+    res.setHeader('Content-Type', { '.html': 'text/html', '.js': 'text/javascript', '.css': 'text/css' }[extname(path)] || 'text/plain');
+    res.end(await readFile(path));
+  } catch { res.writeHead(404).end(); }
+});
+await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+const browser = await chromium.launch({ headless: true, executablePath: process.env.QUOTE_CHROMIUM });
+try {
+  for (const [width, busy] of [[1440, true], [390, true], [1440, false], [390, false]]) {
+    const page = await browser.newPage({ viewport: { width, height: 900 } });
+    const sent = [];
+    await page.addInitScript(busy => {
+      window.EventSource = class {
+        constructor() {
+          window.fixtureEvents = this;
+          setTimeout(() => this.onmessage?.({ data: JSON.stringify({ messages: [], busy, error: null,
+            activity: 'Working', steering: [], context: null, sessionId: 'fixture' }) }), 0);
+        }
+        close() {}
+      };
+      if (!sessionStorage.getItem('fixture-ready')) {
+        sessionStorage.setItem('fixture-ready', 'yes');
+        sessionStorage.setItem('open-document', '/notes/one.md');
+      }
+    }, busy);
+    await page.route('**/api/**', async route => {
+      const url = new URL(route.request().url());
+      let json = {};
+      if (url.pathname === '/api/documents/content') json = { path: url.searchParams.get('path'),
+        content: '# Fixture\n\nA selected passage for discussion.\n\n[Next](two.md)' };
+      else if (url.pathname === '/api/documents/resolve') json = { path: '/notes/two.md' };
+      else if (url.pathname === '/api/documents/pick') json = { path: '/notes/one.md' };
+      else if (url.pathname === '/api/chat') { sent.push(route.request().postDataJSON()); json = { accepted: true }; }
+      else throw new Error(`Unexpected API: ${url.pathname}`);
+      await route.fulfill({ json });
+    });
+    await page.goto(`http://127.0.0.1:${server.address().port}/`);
+    const composer = page.getByRole('textbox', { name: 'Message Pi' });
+    const action = page.getByRole('button', { name: 'Add quote to draft', exact: true });
+    async function select() {
+      await page.locator('.markdown-document p').first().scrollIntoViewIfNeeded();
+      await page.locator('.markdown-document p').first().evaluate(el => {
+        const range = document.createRange(); range.selectNodeContents(el);
+        const selection = window.getSelection(); selection.removeAllRanges(); selection.addRange(range);
+      });
+      await action.waitFor();
+    }
+    await composer.fill('Prior draft');
+    await page.locator('.markdown-document p').first().evaluate(el => {
+      const range = document.createRange(); range.setStart(el.firstChild, 1); range.setEnd(el.firstChild, 2);
+      const selection = window.getSelection(); selection.removeAllRanges(); selection.addRange(range);
+    });
+    await page.waitForTimeout(50);
+    assert.equal(await action.count(), 0, 'Whitespace alone has no quote action');
+    await select();
+    assert.equal(await composer.inputValue(), 'Prior draft');
+    const fit = await action.evaluate(el => {
+      const rect = el.getBoundingClientRect();
+      const range = document.createRange(); range.selectNodeContents(el);
+      const lines = [...range.getClientRects()];
+      const text = range.getBoundingClientRect();
+      return { lines: lines.length, fits: text.left >= rect.left && text.right <= rect.right
+        && text.top >= rect.top && text.bottom <= rect.bottom, onScreen: rect.left >= 0 && rect.right <= innerWidth,
+        whiteSpace: getComputedStyle(el).whiteSpace };
+    });
+    assert.deepEqual(fit, { lines: 1, fits: true, onScreen: true, whiteSpace: 'nowrap' });
+    await page.getByRole('button', { name: 'Dismiss quote action' }).click();
+    assert.equal(await composer.inputValue(), 'Prior draft');
+    await select();
+    await page.keyboard.press('Escape');
+    assert.equal(await action.count(), 0);
+    await select();
+    await action.click();
+    const first = 'Prior draft\n\nFrom /notes/one.md:\n> A selected passage for discussion.';
+    assert.equal(await composer.inputValue(), first);
+    assert.equal(await composer.evaluate(el => el === document.activeElement), true);
+    assert.equal(sent.length, 0);
+    await select();
+    // Keyboard activation of the same accessible action.
+    await action.focus(); await page.keyboard.press('Enter');
+    assert.equal(await composer.inputValue(), first + '\n\nFrom /notes/one.md:\n> A selected passage for discussion.');
+    assert.equal(sent.length, 0);
+    await page.reload();
+    assert.equal(await composer.inputValue(), first + '\n\nFrom /notes/one.md:\n> A selected passage for discussion.');
+    await select();
+    await page.getByRole('link', { name: 'Next' }).focus();
+    await page.keyboard.press('Enter');
+    await page.locator('.document-toolbar strong').filter({ hasText: '/notes/two.md' }).waitFor();
+    assert.equal(await action.count(), 0);
+    await select(); await action.click();
+    assert.ok((await composer.inputValue()).includes('From /notes/two.md:'));
+    await composer.fill('x'.repeat(99999));
+    await select(); await action.click();
+    assert.equal((await composer.inputValue()).length, 99999);
+    await page.getByRole('alert').filter({ hasText: 'Quote not added' }).waitFor();
+    assert.equal(sent.length, 0);
+    await select();
+    await page.getByRole('button', { name: 'Close document' }).click();
+    assert.equal(await action.count(), 0);
+    await composer.fill(first + '\nMy edited question');
+    await page.getByRole('button', { name: busy ? 'Steer Pi' : 'Send message', exact: true }).click();
+    await page.waitForFunction(() => document.querySelector('textarea').value === '');
+    await new Promise(resolve => setTimeout(resolve, 100));
+    assert.equal(sent.length, 1);
+    assert.equal(sent[0].message, first + '\nMy edited question');
+    console.log(`PASS ${width}px, busy=${busy}: single-line label fits control; quote/dismiss/Escape/repeat/keyboard/persistence/navigation/limit/close/send; no implicit delivery`);
+    await page.close();
+  }
+} finally {
+  await browser.close();
+  server.close();
+}
diff --git a/tests/quote.test.ts b/tests/quote.test.ts
new file mode 100644
index 0000000..6620f67
--- /dev/null
+++ b/tests/quote.test.ts
@@ -0,0 +1,18 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { appendQuote, DRAFT_LIMIT } from '../frontend/quote.ts';
+
+test('quotes append attributed editable Markdown without altering prior draft or passage', () => {
+  assert.equal(appendQuote('Existing work  ', '/notes/a.md', 'First\n\nLast'),
+    'Existing work  \n\nFrom /notes/a.md:\n> First\n> \n> Last');
+  assert.equal(appendQuote('', 'a.md', 'hello'), 'From a.md:\n> hello');
+  assert.equal(appendQuote('draft', 'a.md', ' \n '), null);
+});
+
+test('quote insertion respects the draft limit atomically, including attribution', () => {
+  const quote = appendQuote('', 'a.md', 'hello')!;
+  const exact = 'x'.repeat(DRAFT_LIMIT - quote.length - 2);
+  assert.equal(appendQuote(exact, 'a.md', 'hello')?.length, DRAFT_LIMIT);
+  assert.equal(appendQuote(exact + 'x', 'a.md', 'hello'), null);
+  assert.equal(appendQuote('unchanged', 'a.md', 'x'.repeat(DRAFT_LIMIT)), null);
+});
