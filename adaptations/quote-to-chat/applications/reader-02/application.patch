+// Build first. Supply PLAYWRIGHT_MODULE and optionally CHROME_PATH for local installations.
+// Serves only dist on an ephemeral port; all APIs and event traffic are mocked.
+import assert from 'node:assert/strict';
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { resolve, extname } from 'node:path';
+const { chromium } = await import(process.env.PLAYWRIGHT_MODULE || 'playwright');
+const server = createServer(async (req, res) => {
+  const path = resolve('dist', req.url === '/' ? 'index.html' : `.${req.url}`);
+  if (!path.startsWith(resolve('dist') + '/')) { res.writeHead(403).end(); return; }
+  try {
+    res.setHeader('Content-Type', ({ '.js': 'text/javascript', '.css': 'text/css', '.html': 'text/html' })[extname(path)] || 'text/plain');
+    res.end(await readFile(path));
+  } catch { res.writeHead(404).end(); }
+});
+await new Promise(done => server.listen(0, '127.0.0.1', done));
+let browser;
+try {
+  browser = await chromium.launch({ executablePath: process.env.CHROME_PATH || undefined, headless: true });
+  for (const width of [1440, 390]) {
+    const page = await browser.newPage({ viewport: { width, height: 960 } });
+    const sent = [];
+    let picked = '/docs/first.md';
+    await page.addInitScript(() => {
+      window.EventSource = class {
+        constructor() {
+          window.snapshot = busy => this.onmessage?.({ data: JSON.stringify({ messages: [], busy, error: null, activity: '', steering: [], context: null, sessionId: 'fixture' }) });
+          setTimeout(() => window.snapshot(false), 0);
+        }
+        close() {}
+      };
+    });
+    await page.route('**/api/**', async route => {
+      const url = new URL(route.request().url());
+      let body;
+      if (url.pathname === '/api/documents/pick') body = { path: picked };
+      else if (url.pathname === '/api/documents/content') body = { path: url.searchParams.get('path'), content: '# Fixture\n\nAlpha passage for discussion.\n\nSecond paragraph.\n\n[Next](next.md)' };
+      else if (url.pathname === '/api/documents/resolve') body = { path: '/docs/next.md' };
+      else if (url.pathname === '/api/chat') { sent.push(route.request().postDataJSON()); body = {}; }
+      else throw new Error(`Unexpected API: ${url.pathname}`);
+      await route.fulfill({ json: body });
+    });
+    await page.goto(`http://127.0.0.1:${server.address().port}`);
+    const draft = page.getByRole('textbox', { name: 'Message Pi' });
+    const action = page.getByRole('button', { name: 'Add to chat', exact: true });
+    const value = () => draft.inputValue();
+    const select = async () => {
+      await page.locator('article p').first().scrollIntoViewIfNeeded();
+      await page.evaluate(() => {
+        const node = document.querySelector('article p').firstChild;
+        const range = document.createRange(); range.selectNodeContents(node);
+        const selection = window.getSelection(); selection.removeAllRanges(); selection.addRange(range);
+      });
+      await action.waitFor({ state: 'visible' });
+    };
+    await draft.fill('Existing draft');
+    await page.getByRole('button', { name: 'Open document', exact: true }).click();
+    await page.locator('article').waitFor();
+    // Real pointer selection, independent of the programmatic range cases below.
+    await page.locator('article p').first().scrollIntoViewIfNeeded();
+    const pointerPassage = await page.locator('article p').first().boundingBox();
+    await page.mouse.move(pointerPassage.x + 2, pointerPassage.y + 12);
+    await page.mouse.down();
+    await page.mouse.move(pointerPassage.x + 100, pointerPassage.y + 12, { steps: 12 });
+    await page.mouse.up();
+    await action.waitFor({ state: 'visible' });
+    assert.equal(await value(), 'Existing draft');
+    await page.keyboard.press('Escape');
+    await select();
+    assert.equal(await value(), 'Existing draft');
+    const rect = await action.boundingBox();
+    const passage = await page.locator('article p').first().boundingBox();
+    assert.ok(rect.x >= 0 && rect.x + rect.width <= width && Math.abs(rect.y - passage.y) < 90);
+    await page.keyboard.press('Escape');
+    await action.waitFor({ state: 'hidden' });
+    assert.equal(await value(), 'Existing draft');
+    await select();
+    await action.focus(); await page.keyboard.press('Enter');
+    assert.equal(await value(), 'Existing draft\n\nFrom /docs/first.md:\n> Alpha passage for discussion.\n\n');
+    assert.equal(await draft.evaluate(el => el === document.activeElement), true);
+    assert.equal(sent.length, 0);
+    const first = await value();
+    await page.reload(); await draft.waitFor();
+    assert.equal(await value(), first);
+    await page.evaluate(() => window.snapshot(true));
+    await select(); await action.click();
+    assert.ok((await value()).startsWith(first));
+    assert.equal((await value()).split('From /docs/first.md:').length, 3);
+    assert.equal(sent.length, 0);
+    await draft.fill('x'.repeat(99999));
+    await select(); await action.click();
+    assert.equal((await value()).length, 99999);
+    assert.match(await page.getByRole('alert').innerText(), /Quote not added/);
+    await draft.fill('Kept');
+    await draft.evaluate(el => { el.focus(); el.select(); });
+    await action.waitFor({ state: 'hidden' });
+    // Neither whitespace nor a range crossing out of the article is quotable.
+    for (const kind of ['blank', 'outside']) {
+      await page.evaluate(kind => {
+        const article = document.querySelector('article');
+        const range = document.createRange();
+        if (kind === 'blank') range.selectNodeContents(article.childNodes[1]);
+        else { range.setStart(document.querySelector('.document-toolbar strong').firstChild, 0); range.setEnd(article.querySelector('p').firstChild, 5); }
+        const selection = window.getSelection(); selection.removeAllRanges(); selection.addRange(range);
+      }, kind);
+      await page.waitForTimeout(50);
+      assert.equal(await action.count(), 0);
+    }
+    await select();
+    await page.getByRole('link', { name: 'Next', exact: true }).click();
+    await page.waitForFunction(() => document.querySelector('.document-toolbar strong')?.textContent === '/docs/next.md');
+    await action.waitFor({ state: 'hidden' });
+    assert.equal(await value(), 'Kept');
+    await select();
+    await page.getByRole('button', { name: 'Close document' }).click();
+    await action.waitFor({ state: 'hidden' });
+    assert.equal(await value(), 'Kept');
+    picked = '/docs/reopened.md';
+    await page.getByRole('button', { name: 'Open document', exact: true }).click();
+    await select(); await action.click();
+    assert.match(await value(), /From \/docs\/reopened.md:/);
+    const explicit = await value();
+    assert.equal(sent.length, 0);
+    await page.getByRole('button', { name: 'Steer Pi', exact: true }).click();
+    await page.waitForFunction(() => document.querySelector('textarea').value === '');
+    await page.waitForTimeout(100);
+    assert.deepEqual(sent, [{ message: explicit, sessionId: 'fixture' }]);
+    await page.close();
+    console.log(`quote-to-chat mocked browser acceptance passed at ${width}px`);
+  }
+} finally { await browser?.close(); server.close(); }
diff --git a/tests/document-quotes.test.ts b/tests/document-quotes.test.ts
new file mode 100644
index 0000000..d20d6e8
--- /dev/null
+++ b/tests/document-quotes.test.ts
@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { appendDocumentQuote, DRAFT_LIMIT } from '../frontend/document-quotes.ts';
+
+test('appends attributed, editable multiline text without changing prior work', () => {
+  assert.equal(appendDocumentQuote('My draft  ', { path: '/docs/a.md', text: '  first\r\n\r\nlast' }),
+    'My draft  \n\nFrom /docs/a.md:\n>   first\n> \n> last\n\n');
+});
+test('empty drafts, repeated quoting, and blank selections', () => {
+  const quote = { path: 'a.md', text: 'Passage' };
+  const first = appendDocumentQuote('', quote);
+  assert.equal(first, 'From a.md:\n> Passage\n\n');
+  assert.equal(appendDocumentQuote(first, quote), `${first}\n\n${first}`);
+  assert.equal(appendDocumentQuote('unchanged', { ...quote, text: ' \n\t' }), 'unchanged');
+});
+test('rejects overflow atomically, including attribution overhead', () => {
+  const quote = { path: 'a.md', text: 'Passage' };
+  const overhead = appendDocumentQuote('x', quote).length - 1;
+  assert.equal(appendDocumentQuote('x'.repeat(DRAFT_LIMIT - overhead), quote).length, DRAFT_LIMIT);
+  assert.throws(() => appendDocumentQuote('x'.repeat(DRAFT_LIMIT - overhead + 1), quote), /Quote not added/);
+  assert.throws(() => appendDocumentQuote('work', { ...quote, text: 'x'.repeat(DRAFT_LIMIT) }), /Quote not added/);
+});
