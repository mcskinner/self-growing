+++ b/backend/documents.py
@@ -0,0 +1,237 @@
+"""Open original Markdown files and keep review annotations inside them."""
+
+import asyncio
+import json
+import os
+import re
+import sys
+import tempfile
+from pathlib import Path
+from uuid import uuid4
+
+from fastapi import APIRouter, HTTPException
+from pydantic import BaseModel, Field, ValidationError
+
+router = APIRouter(prefix="/api/documents")
+ROOT = Path(__file__).resolve().parents[1]
+EXCLUDED = {"node_modules", "dist", "__pycache__"}
+MARKER = "<!-- markdown-review:v1\n"
+REVIEW_BLOCK = re.compile(r"<!-- markdown-review:v1\r?\n(.*?)\r?\n-->\s*\Z", re.DOTALL)
+
+
+class TextAnchor(BaseModel):
+    start: int = Field(ge=0)
+    end: int = Field(ge=0)
+    prefix: str = Field(default="", max_length=48)
+    suffix: str = Field(default="", max_length=48)
+
+
+class Comment(BaseModel):
+    text: str = Field(min_length=1, max_length=20_000)
+    quote: str = Field(default="", max_length=10_000)
+    anchor: TextAnchor | None = None
+
+
+class SavedComment(Comment):
+    id: str = Field(min_length=1, max_length=128)
+    resolved: bool = False
+
+
+def document_path(path: str) -> Path:
+    supplied = Path(path)
+    target = (ROOT / supplied).resolve()
+    if not supplied.is_absolute() and (
+        any(part.startswith(".") or part in EXCLUDED for part in supplied.parts)
+        or not target.is_relative_to(ROOT.resolve())
+        or any(
+            part.startswith(".") or part in EXCLUDED
+            for part in target.relative_to(ROOT.resolve()).parts
+        )
+    ):
+        raise HTTPException(404, "Markdown document not found")
+    if target.suffix.lower() not in {".md", ".markdown"} or not target.is_file():
+        raise HTTPException(404, "Markdown document not found")
+    if target.stat().st_size > 2_000_000:
+        raise HTTPException(413, "Document is too large (maximum 2 MB)")
+    return target
+
+
+def legacy_comments(target: Path):
+    """Read old reviews as a fallback; never migrate or write merely by opening a file."""
+    file = ROOT / ".local" / "reviews.json"
+    if not target.is_relative_to(ROOT.resolve()) or not file.exists():
+        return []
+    reviews = json.loads(file.read_text())
+    return reviews.get(target.relative_to(ROOT.resolve()).as_posix(), [])
+
+
+def read_document(target: Path):
+    original = target.read_bytes()
+    try:
+        source = original.decode("utf-8")
+    except UnicodeDecodeError:
+        raise HTTPException(422, "Document is not UTF-8 text") from None
+    match = REVIEW_BLOCK.search(source)
+    if match:
+        try:
+            data = json.loads(match[1])
+            comments = [SavedComment.model_validate(item).model_dump() for item in data["comments"]]
+        except (ValueError, KeyError, TypeError, ValidationError):
+            raise HTTPException(
+                422, "Review metadata is invalid; the file was not changed"
+            ) from None
+        return original, source[: match.start()], comments, match.start(), "embedded"
+    if "<!-- markdown-review:" in source:
+        raise HTTPException(
+            422, "Review metadata is unsupported or misplaced; the file was not changed"
+        )
+    comments = legacy_comments(target)
+    return original, source, comments, None, "legacy" if comments else "embedded"
+
+
+def write_comments(target: Path, original: bytes, source: str, comments: list, start: int | None):
+    # Escape HTML-comment delimiters while keeping the payload valid, readable JSON.
+    payload = json.dumps({"comments": comments}, ensure_ascii=False, indent=2)
+    payload = payload.replace("-", "\\u002d").replace("<", "\\u003c").replace(">", "\\u003e")
+    newline = "\r\n" if "\r\n" in source else "\n"
+    separator = "" if start is not None else (newline if source.endswith("\n") else newline * 2)
+    block = (MARKER + payload + "\n-->\n").replace("\n", newline)
+    updated = (source + separator + block).encode("utf-8")
+    if len(updated) > 2_000_000:
+        raise HTTPException(413, "Document with annotations exceeds 2 MB")
+    temporary = None
+    try:
+        # Respect read-only documents, even when their parent directory is writable.
+        if not os.access(target, os.W_OK):
+            raise HTTPException(403, "Document is read-only")
+        with tempfile.NamedTemporaryFile(
+            dir=target.parent, prefix=f".{target.name}.", delete=False
+        ) as file:
+            temporary = Path(file.name)
+            file.write(updated)
+        temporary.chmod(target.stat().st_mode & 0o777)
+        if target.read_bytes() != original:
+            raise HTTPException(409, "Document changed while saving; retry your comment")
+        temporary.replace(target)
+    except PermissionError:
+        raise HTTPException(403, "Cannot write annotations to this document") from None
+    finally:
+        if temporary and temporary.exists():
+            temporary.unlink()
+
+
+def snapshot(path: str, target: Path):
+    _, source, comments, _, storage = read_document(target)
+    return {"path": path, "content": source, "comments": comments, "storage": storage}
+
+
+async def choose_markdown_file():
+    if sys.platform != "darwin":
+        raise HTTPException(501, "The native file chooser currently supports macOS only")
+    script = """try
+        set picked to choose file with prompt "Open Markdown" of type {"md", "markdown"}
+        return POSIX path of picked
+    on error number -128
+        return ""
+    end try"""
+    process = await asyncio.create_subprocess_exec(
+        "/usr/bin/osascript",
+        "-e",
+        script,
+        stdout=asyncio.subprocess.PIPE,
+        stderr=asyncio.subprocess.PIPE,
+    )
+    try:
+        async with asyncio.timeout(300):
+            stdout, stderr = await process.communicate()
+    finally:
+        if process.returncode is None:
+            process.kill()
+            await process.wait()
+    if process.returncode:
+        raise HTTPException(500, f"Could not open file chooser: {stderr.decode().strip()}")
+    return stdout.decode().rstrip("\r\n")
+
+
+@router.post("/pick")
+async def pick_document():
+    selected = await choose_markdown_file()
+    if not selected:
+        return {"path": None}
+    target = document_path(selected)
+    # Selection and opening are read-only. The original is changed only by saving annotations.
+    read_document(target)
+    relative = target.relative_to(ROOT.resolve()) if target.is_relative_to(ROOT.resolve()) else None
+    path = (
+        relative.as_posix()
+        if relative and not any(part.startswith(".") or part in EXCLUDED for part in relative.parts)
+        else str(target)
+    )
+    return {"path": path}
+
+
+@router.get("")
+async def list_documents():
+    paths = []
+    for directory, folders, files in os.walk(ROOT, followlinks=False):
+        folders[:] = sorted(
+            name for name in folders if not name.startswith(".") and name not in EXCLUDED
+        )
+        for name in files:
+            path = Path(directory, name).relative_to(ROOT).as_posix()
+            if name.lower().endswith((".md", ".markdown")) and not name.startswith("."):
+                try:
+                    document_path(path)
+                    paths.append(path)
+                except HTTPException:
+                    pass
+    return sorted(paths)
+
+
+@router.get("/content")
+async def get_document(path: str):
+    return snapshot(path, document_path(path))
+
+
+@router.post("/comments", status_code=201)
+async def add_comment(path: str, body: Comment):
+    target = document_path(path)
+    if not body.text.strip():
+        raise HTTPException(422, "Comment must not be blank")
+    if (
+        body.anchor
+        and body.anchor.end - body.anchor.start != len(body.quote.encode("utf-16-le")) // 2
+    ):
+        raise HTTPException(422, "Anchor length must match the selected text")
+    original, source, comments, start, _ = read_document(target)
+    comment = {
+        "id": uuid4().hex,
+        "text": body.text.strip(),
+        "quote": body.quote,
+        "anchor": body.anchor.model_dump() if body.anchor else None,
+        "resolved": False,
+    }
+    comments.append(comment)
+    write_comments(target, original, source, comments, start)
+    return comment
+
+
+@router.patch("/comments/{comment_id}")
+async def toggle_comment(comment_id: str, path: str):
+    target = document_path(path)
+    original, source, comments, start, _ = read_document(target)
+    for comment in comments:
+        if comment["id"] == comment_id:
+            comment["resolved"] = not comment["resolved"]
+            write_comments(target, original, source, comments, start)
+            return comment
+    raise HTTPException(404, "Comment not found")
+
+
+@router.post("/migrate")
+async def migrate_comments(path: str):
+    target = document_path(path)
+    original, source, comments, start, storage = read_document(target)
+    if storage == "legacy":
+        write_comments(target, original, source, comments, start)
+    return snapshot(path, target)
diff --git a/frontend/annotations.ts b/frontend/annotations.ts
new file mode 100644
index 0000000..f62c92d
--- /dev/null
+++ b/frontend/annotations.ts
@@ -0,0 +1,62 @@
+export interface Anchor { start: number; end: number; prefix: string; suffix: string }
+export interface Annotation { id: string; quote: string; anchor?: Anchor | null }
+
+/** Never silently attach an ambiguous repeated excerpt to the wrong passage. */
+export function locate(text: string, annotation: Annotation): number | null {
+  const { quote, anchor } = annotation;
+  if (!quote) return null;
+  const matches: number[] = [];
+  let from = 0;
+  while (from <= text.length - quote.length) {
+    const at = text.indexOf(quote, from);
+    if (at < 0) break;
+    matches.push(at); from = at + 1;
+  }
+  if (matches.length === 1) return matches[0];
+  if (!anchor) return null;
+  const contextual = matches.filter(at =>
+    text.slice(Math.max(0, at - anchor.prefix.length), at) === anchor.prefix &&
+    text.slice(at + quote.length, at + quote.length + anchor.suffix.length) === anchor.suffix);
+  return contextual.length === 1 ? contextual[0] : null;
+}
+
+export function annotate(html: string, annotations: Annotation[]) {
+  const container = document.createElement('div');
+  container.innerHTML = html;
+  const text = container.textContent || '';
+  const ranges = annotations.flatMap(annotation => {
+    const start = locate(text, annotation);
+    return start === null ? [] : [{ id: annotation.id, start, end: start + annotation.quote.length }];
+  });
+  const walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT);
+  const nodes: Text[] = [];
+  while (walker.nextNode()) nodes.push(walker.currentNode as Text);
+  let offset = 0;
+  for (const node of nodes) {
+    const value = node.data;
+    const end = offset + value.length;
+    const intersecting = ranges.filter(range => range.start < end && range.end > offset);
+    if (intersecting.length) {
+      const boundaries = [...new Set([0, value.length, ...intersecting.flatMap(range =>
+        [Math.max(0, range.start - offset), Math.min(value.length, range.end - offset)])])].sort((a, b) => a - b);
+      const fragment = document.createDocumentFragment();
+      for (let i = 0; i < boundaries.length - 1; i++) {
+        const start = boundaries[i];
+        const segment = value.slice(start, boundaries[i + 1]);
+        const ids = intersecting.filter(range => range.start <= offset + start && range.end > offset + start).map(range => range.id);
+        if (ids.length) {
+          const mark = document.createElement('mark');
+          mark.dataset.comments = ids.join(' ');
+          mark.tabIndex = 0;
+          mark.setAttribute('role', 'button');
+          mark.setAttribute('aria-label', `Show ${ids.length > 1 ? 'comments' : 'comment'} on: ${segment}`);
+          mark.textContent = segment;
+          fragment.append(mark);
+        } else fragment.append(document.createTextNode(segment));
+      }
+      node.replaceWith(fragment);
+    }
+    offset = end;
+  }
+  return { html: container.innerHTML, attached: new Set(ranges.map(range => range.id)) };
+}
diff --git a/frontend/documents.tsx b/frontend/documents.tsx
new file mode 100644
index 0000000..5fae592
--- /dev/null
+++ b/frontend/documents.tsx
@@ -0,0 +1,250 @@
+import { useEffect, useLayoutEffect, useMemo, useRef, useState } from 'react';
+import { annotate, type Anchor } from './annotations';
+import DOMPurify from 'dompurify';
+import { marked } from 'marked';
+
+interface Comment { id: string; text: string; quote: string; resolved: boolean; anchor?: Anchor | null }
+interface Document { path: string; content: string; comments: Comment[]; storage: 'embedded' | 'legacy' }
+interface SelectionAnchor { quote: string; anchor: Anchor }
+interface Candidate extends SelectionAnchor { x: number; y: number }
+
+async function request<T>(url: string, init?: RequestInit): Promise<T> {
+  const response = await fetch(url, init);
+  if (!response.ok) throw new Error((await response.json()).detail || 'Request failed');
+  return response.json();
+}
+
+export function DocumentPicker({ onOpen }: { onOpen: (path: string) => void }) {
+  const [opening, setOpening] = useState(false);
+  const [error, setError] = useState('');
+  async function open() {
+    setOpening(true); setError('');
+    try {
+      const result = await request<{ path: string | null }>('/api/documents/pick', { method: 'POST' });
+      if (result.path) onOpen(result.path);
+    } catch (err) { setError(String(err)); }
+    finally { setOpening(false); }
+  }
+  return <div className="document-picker">
+    <button className="icon-button" disabled={opening} aria-label="Open document" title={opening ? 'Choosing document…' : 'Open document'}
+      aria-busy={opening} onClick={() => void open()}>
+      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5"
+        strokeLinecap="round" strokeLinejoin="round" aria-hidden="true" focusable="false">
+        <path d="M20 20H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2Z" />
+      </svg>
+    </button>
+    {error && <span className="error" role="alert">{error}</span>}
+  </div>;
+}
+
+export function DocumentView({ path, busy, onClose, onReview }: {
+  path: string; busy: boolean; onClose: () => void; onReview: (text: string) => void;
+}) {
+  const [doc, setDoc] = useState<Document | null>(null);
+  const [error, setError] = useState('');
+  const [loading, setLoading] = useState(true);
+  const [loadAttempt, setLoadAttempt] = useState(0);
+  const [candidate, setCandidate] = useState<Candidate | null>(null);
+  const [draft, setDraft] = useState<SelectionAnchor | null>(null);
+  const [text, setText] = useState('');
+  const [active, setActive] = useState('');
+  const [showResolved, setShowResolved] = useState(false);
+  const [saving, setSaving] = useState(false);
+  const [updating, setUpdating] = useState('');
+  const [layout, setLayout] = useState<{ tops: Record<string, number>; height: number }>({ tops: {}, height: 0 });
+  const article = useRef<HTMLElement>(null);
+  const canvas = useRef<HTMLDivElement>(null);
+  const rail = useRef<HTMLElement>(null);
+  const commentInput = useRef<HTMLTextAreaElement>(null);
+  const url = `/api/documents/content?path=${encodeURIComponent(path)}`;
+  useEffect(() => {
+    const controller = new AbortController();
+    setLoading(true); setError('');
+    request<Document>(url, { signal: controller.signal }).then(data => {
+      if (!controller.signal.aborted) setDoc(data);
+    }).catch(err => {
+      if (controller.signal.aborted) return;
+      const message = err instanceof Error ? err.message : String(err);
+      setError(message === 'Not Found' ? 'The document service is not ready. Please retry.' : message);
+    }).finally(() => { if (!controller.signal.aborted) setLoading(false); });
+    return () => controller.abort();
+  }, [url, busy, loadAttempt]);
+  const html = useMemo(() => DOMPurify.sanitize(marked.parse(doc?.content || '', { async: false }), {
+    FORBID_TAGS: ['img', 'style', 'input', 'mark'], FORBID_ATTR: ['style', 'data-comments', 'data-thread'],
+  }), [doc?.content]);
+  const openComments = useMemo(() => doc?.comments.filter(comment => !comment.resolved) || [], [doc]);
+  const visible = useMemo(() => doc?.comments.filter(comment => showResolved || !comment.resolved) || [], [doc, showResolved]);
+  const annotated = useMemo(() => annotate(html, [
+    ...visible, ...(draft ? [{ ...draft, id: 'draft' }] : []),
+  ]), [html, visible, draft]);
+
+  // Capture offsets in the rendered text, plus surrounding context to reattach after edits.
+  useEffect(() => {
+    function capture() {
+      const selection = window.getSelection();
+      const root = article.current;
+      if (!selection || !root || selection.isCollapsed || !selection.rangeCount ||
+        !root.contains(selection.anchorNode) || !root.contains(selection.focusNode)) {
+        setCandidate(null); return;
+      }
+      const range = selection.getRangeAt(0);
+      const quote = range.toString();
+      if (!quote.trim() || quote.length > 10000) { setCandidate(null); return; }
+      const before = range.cloneRange();
+      before.selectNodeContents(root);
+      before.setEnd(range.startContainer, range.startOffset);
+      const start = before.toString().length;
+      const end = start + quote.length;
+      const full = root.textContent || '';
+      const rect = range.getBoundingClientRect();
+      setCandidate({ quote, anchor: { start, end, prefix: full.slice(Math.max(0, start - 48), start), suffix: full.slice(end, end + 48) },
+        x: Math.max(8, Math.min(rect.left, window.innerWidth - 170)), y: Math.max(8, Math.min(rect.bottom + 8, window.innerHeight - 48)) });
+    }
+    document.addEventListener('selectionchange', capture);
+    return () => document.removeEventListener('selectionchange', capture);
+  }, []);
+
+  // Cards follow their passages vertically, stacking rather than overlapping.
+  useLayoutEffect(() => {
+    if (!canvas.current || !article.current || !rail.current) return;
+    function measure() {
+      const root = canvas.current!;
+      const base = root.getBoundingClientRect().top;
+      const marks = Array.from(article.current!.querySelectorAll<HTMLElement>('mark[data-comments]'));
+      const cards = Array.from(rail.current!.querySelectorAll<HTMLElement>('[data-thread]'));
+      const entries = cards.map(card => {
+        const id = card.dataset.thread!;
+        const mark = marks.find(item => item.dataset.comments?.split(' ').includes(id));
+        return { id, card, target: mark ? mark.getBoundingClientRect().top - base : article.current!.offsetHeight + 24 };
+      }).sort((a, b) => a.target - b.target);
+      const tops: Record<string, number> = {};
+      let bottom = 0;
+      for (const entry of entries) {
+        const top = Math.max(bottom, entry.target);
+        tops[entry.id] = top;
+        bottom = top + entry.card.offsetHeight + 12;
+      }
+      const next = { tops, height: bottom };
+      setLayout(current => JSON.stringify(current) === JSON.stringify(next) ? current : next);
+    }
+    measure();
+    const observer = new ResizeObserver(measure);
+    observer.observe(article.current);
+    rail.current.querySelectorAll('[data-thread]').forEach(card => observer.observe(card));
+    return () => observer.disconnect();
+  }, [annotated, visible, draft]);
+
+  useEffect(() => {
+    article.current?.querySelectorAll<HTMLElement>('mark[data-comments]').forEach(mark => {
+      const selected = mark.dataset.comments?.split(' ').includes(active) || false;
+      mark.classList.toggle('active-annotation', selected);
+      mark.setAttribute('aria-pressed', String(selected));
+    });
+  }, [active, annotated]);
+
+  useEffect(() => { if (draft) commentInput.current?.focus(); }, [draft]);
+
+  async function addComment() {
+    if (!text.trim() || !draft || saving) return;
+    setSaving(true); setError('');
+    try {
+      const comment = await request<Comment>(`/api/documents/comments?path=${encodeURIComponent(path)}`, {
+        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text, ...draft }),
+      });
+      setDoc(current => current && { ...current, storage: 'embedded', comments: [...current.comments, comment] });
+      setText(''); setDraft(null); setActive(comment.id);
+    } catch (err) { setError(String(err)); }
+    finally { setSaving(false); }
+  }
+
+  async function toggle(comment: Comment) {
+    setUpdating(comment.id);
+    try {
+      const updated = await request<Comment>(`/api/documents/comments/${comment.id}?path=${encodeURIComponent(path)}`, { method: 'PATCH' });
+      setDoc(current => current && { ...current, storage: 'embedded', comments: current.comments.map(item => item.id === updated.id ? updated : item) });
+      setError('');
+    } catch (err) { setError(String(err)); }
+    finally { setUpdating(''); }
+  }
+
+  function activate(id: string, fromCard = false) {
+    setActive(id);
+    const target = fromCard
+      ? Array.from(article.current?.querySelectorAll<HTMLElement>('mark[data-comments]') || []).find(mark => mark.dataset.comments?.split(' ').includes(id))
+      : Array.from(rail.current?.querySelectorAll<HTMLElement>('[data-thread]') || []).find(card => card.dataset.thread === id);
+    target?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+  }
+  function activateMark(target: EventTarget) {
+    const mark = (target as HTMLElement).closest<HTMLElement>('mark[data-comments]');
+    if (!mark) return;
+    const ids = mark.dataset.comments!.split(' ').filter(id => id !== 'draft');
+    if (ids.length) activate(ids[(ids.indexOf(active) + 1) % ids.length]);
+  }
+
+  return <section className="document-panel" aria-label="Document review">
+    <div className="document-toolbar"><div><span className="eyebrow">DOCUMENT REVIEW</span><strong title={path}>{path}</strong></div>
+      <button className="icon-button" onClick={onClose} aria-label="Close document" title="Close document">
+        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5"
+          strokeLinecap="round" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18" /></svg>
+      </button></div>
+    <div className="annotation-toolbar">
+      <span title="Saving or resolving a comment updates an HTML metadata block in the original Markdown file.">Select a passage to comment · {openComments.length} open · {doc?.storage === 'legacy' ? 'Earlier comments not yet embedded' : 'Saved in Markdown'}</span>
+      {doc?.storage === 'legacy' && <button className="quiet-button" disabled={saving} onClick={async () => {
+        setSaving(true);
+        try { setDoc(await request<Document>(`/api/documents/migrate?path=${encodeURIComponent(path)}`, { method: 'POST' })); setError(''); }
+        catch (err) { setError(String(err)); }
+        finally { setSaving(false); }
+      }}>Move existing comments into file</button>}
+      <label><input type="checkbox" checked={showResolved} onChange={event => setShowResolved(event.target.checked)} /> Show resolved</label>
+      <button className="quiet-button" disabled={!openComments.length} onClick={() => onReview(
+        `Please revise ${path} based on these annotations. Read the current document first; some passages may have changed. Preserve the markdown-review HTML metadata block and comment IDs.\n\n` +
+        openComments.map((comment, index) => `${index + 1}. ${comment.quote ? `On this passage:\n> ${comment.quote.replace(/\n/g, '\n> ')}\n` : ''}${comment.text}`).join('\n\n')
+      )}>Send review to chat ↗</button>
+    </div>
