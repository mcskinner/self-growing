@@ -0,0 +1,134 @@
+import { useEffect, useMemo, useRef, useState, type ReactNode } from 'react';
+import { renderMarkdown } from './markdown';
+import './reader.css';
+
+interface DocumentData { path: string; name: string; content: string }
+
+async function result(response: Response) {
+  const data = await response.json();
+  if (!response.ok) throw new Error(data.detail || 'Could not open Markdown');
+  return data;
+}
+
+function stored(storage: Storage, key: string) {
+  try { return storage.getItem(key) || ''; } catch { return ''; }
+}
+function remember(storage: Storage, key: string, value: string) {
+  try { if (value) storage.setItem(key, value); else storage.removeItem(key); } catch { /* Optional preference. */ }
+}
+const clampWidth = (width: number) => Math.max(25, Math.min(75, width));
+
+export function ReaderWorkspace({ busy, children }: { busy: boolean; children: ReactNode }) {
+  const [path, setPath] = useState(() => stored(sessionStorage, 'reader-path'));
+  const [data, setData] = useState<DocumentData | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState('');
+  const [retry, setRetry] = useState(0);
+  const [choosing, setChoosing] = useState(false);
+  const [candidate, setCandidate] = useState('');
+  const [picking, setPicking] = useState(false);
+  const [pickError, setPickError] = useState('');
+  const [width, setWidth] = useState(() => {
+    const saved = Number(stored(localStorage, 'reader-width'));
+    return saved ? clampWidth(saved) : 55;
+  });
+  const workspace = useRef<HTMLDivElement>(null);
+  const dialog = useRef<HTMLDialogElement>(null);
+  const previousBusy = useRef(busy);
+  const [refresh, setRefresh] = useState(0);
+
+  useEffect(() => {
+    if (previousBusy.current && !busy) setRefresh(value => value + 1);
+    previousBusy.current = busy;
+  }, [busy]);
+  useEffect(() => { remember(sessionStorage, 'reader-path', path); }, [path]);
+  useEffect(() => { remember(localStorage, 'reader-width', String(width)); }, [width]);
+  useEffect(() => {
+    if (choosing) dialog.current?.showModal();
+    else dialog.current?.close();
+  }, [choosing]);
+
+  useEffect(() => {
+    if (!path) { setData(null); setError(''); setLoading(false); return; }
+    const controller = new AbortController();
+    setLoading(true); setError('');
+    void fetch(`/api/documents/content?path=${encodeURIComponent(path)}`, {
+      signal: controller.signal, cache: 'no-store',
+    }).then(result).then((value: DocumentData) => {
+      if (!controller.signal.aborted) setData(value);
+    }).catch(err => {
+      if (!controller.signal.aborted) setError(String(err));
+    }).finally(() => { if (!controller.signal.aborted) setLoading(false); });
+    return () => controller.abort();
+  }, [path, retry, refresh]);
+  const html = useMemo(() => renderMarkdown(data?.content || ''), [data?.content]);
+
+  function open(next: string) {
+    if (next !== path) setData(null);
+    setPath(next); setRetry(value => value + 1); setChoosing(false);
+  }
+  async function pick() {
+    setPicking(true); setPickError('');
+    try {
+      const selected = await result(await fetch('/api/documents/pick', { method: 'POST' }));
+      if (selected.path) open(selected.path);
+    } catch (err) { setPickError(String(err)); }
+    finally { setPicking(false); }
+  }
+  function resize(clientX: number) {
+    const bounds = workspace.current!.getBoundingClientRect();
+    setWidth(clampWidth((clientX - bounds.left) / bounds.width * 100));
+  }
+
+  return <>
+    <div className="reader-bar">
+      <button type="button" className="quiet-button" onClick={() => {
+        setCandidate(path); setPickError(''); setChoosing(true);
+      }}>{path ? 'Choose another Markdown' : 'Open Markdown'}</button>
+      {path && <><span className="reader-path" title={path}>{data?.path || path}</span>
+        <button type="button" className="quiet-button" onClick={() => setRetry(value => value + 1)}>Refresh</button>
+        <button type="button" className="quiet-button" onClick={() => setPath('')}>Close reader</button></>}
+    </div>
+    <dialog ref={dialog} className="document-picker" onCancel={event => { if (picking) event.preventDefault(); else setChoosing(false); }}>
+      <h2>Open original Markdown</h2>
+      <p>Read-only · No upload or copy. Use an absolute path for files outside this workspace.</p>
+      <form onSubmit={event => { event.preventDefault(); if (!picking && candidate.trim()) open(candidate.trim()); }}>
+        <label htmlFor="document-path">File path (.md or .markdown)</label>
+        <input id="document-path" autoFocus value={candidate} disabled={picking}
+          onChange={event => setCandidate(event.target.value)} placeholder="/path/to/document.md" />
+        <div className="picker-actions">
+          <button type="button" className="quiet-button" disabled={picking} onClick={() => void pick()}>{picking ? 'Choosing…' : 'Browse local files…'}</button>
+          <button type="submit" className="quiet-button" disabled={picking || !candidate.trim()}>Open</button>
+          <button type="button" className="quiet-button" disabled={picking} onClick={() => setChoosing(false)}>Cancel</button>
+        </div>
+      </form>
+      {pickError && <p className="error" role="alert">{pickError}</p>}
+    </dialog>
+    <div ref={workspace} className={`workspace ${path ? 'with-document' : ''}`}
+      style={{ '--reader-width': `${width}%` } as React.CSSProperties}>
+      {path && <>
+        <section className="document-pane" aria-label="Markdown reader">
+          {loading && <div className="reader-status" role="status">{data ? 'Refreshing Markdown…' : 'Loading Markdown…'}</div>}
+          {error && <div className="reader-status error" role="alert">{error} <button type="button" className="quiet-button" onClick={() => setRetry(value => value + 1)}>Retry</button></div>}
+          {data && <article className="markdown-document" aria-label={data.name} dangerouslySetInnerHTML={{ __html: html }} />}
+        </section>
+        <div className="pane-resizer" role="separator" tabIndex={0} aria-label="Reader width"
+          aria-orientation="vertical" aria-valuemin={25} aria-valuemax={75} aria-valuenow={Math.round(width)}
+          onKeyDown={event => {
+            const next = event.key === 'ArrowLeft' ? width - 2 : event.key === 'ArrowRight' ? width + 2
+              : event.key === 'Home' ? 25 : event.key === 'End' ? 75 : null;
+            if (next !== null) { event.preventDefault(); setWidth(clampWidth(next)); }
+          }}
+          onPointerDown={event => {
+            if (event.button !== 0) return;
+            event.preventDefault(); event.currentTarget.setPointerCapture(event.pointerId); resize(event.clientX);
+          }}
+          onPointerMove={event => { if (event.currentTarget.hasPointerCapture(event.pointerId)) resize(event.clientX); }}
+          onPointerUp={event => {
+            if (event.currentTarget.hasPointerCapture(event.pointerId)) event.currentTarget.releasePointerCapture(event.pointerId);
+          }} />
+      </>}
+      <div className="chat-pane">{children}</div>
+    </div>
+  </>;
+}
