+    monkeypatch.setattr(documents, "WORKSPACE", tmp_path)
+    return TestClient(app)
+
+
+def test_reads_original_inside_and_outside_workspace(client, tmp_path):
+    inside = tmp_path / "notes.markdown"
+    outside = tmp_path.parent / f"{tmp_path.name}-outside.md"
+    inside.write_text("# Café\n\n| A | B |\n|---|---|\n| x | y |\n", encoding="utf-8")
+    outside.write_text("External original", encoding="utf-8")
+    try:
+        for path in ("notes.markdown", str(outside)):
+            before = Path(path) if Path(path).is_absolute() else tmp_path / path
+            original = before.read_bytes()
+            response = client.get("/api/documents/content", params={"path": path})
+            assert response.status_code == 200
+            assert response.json()["content"] == original.decode("utf-8")
+            assert response.json()["path"] == str(before.resolve())
+            assert before.read_bytes() == original
+        assert sorted(p.name for p in tmp_path.iterdir()) == ["notes.markdown"]
+    finally:
+        outside.unlink()
+
+
+def test_resolved_relative_paths_cannot_escape(client, tmp_path):
+    (tmp_path / "escape.md").symlink_to(tmp_path.parent / "outside.md")
+    for path in ("../outside.md", "escape.md"):
+        assert client.get("/api/documents/content", params={"path": path}).status_code == 403
+
+
+def test_file_validation(client, tmp_path):
+    (tmp_path / "wrong.txt").write_text("text")
+    (tmp_path / "bad.md").write_bytes(b"\xff")
+    (tmp_path / "large.md").write_bytes(b"x" * (documents.MAX_BYTES + 1))
+    (tmp_path / "directory.md").mkdir()
+    for path, status in [
+        ("wrong.txt", 422),
+        ("bad.md", 422),
+        ("large.md", 413),
+        ("missing.md", 404),
+        ("directory.md", 404),
+        ("", 422),
+        ("bad\x00.md", 422),
+    ]:
+        assert client.get("/api/documents/content", params={"path": path}).status_code == status
+    (tmp_path / "limit.MD").write_bytes(b"x" * documents.MAX_BYTES)
+    assert client.get("/api/documents/content", params={"path": "limit.MD"}).status_code == 200
+
+
+def test_native_choice_and_cancel_do_not_copy(client, monkeypatch, tmp_path):
+    async def choose():
+        return "/outside/original.md"
+
+    monkeypatch.setattr(documents, "choose_markdown_file", choose)
+    assert client.post("/api/documents/pick").json() == {"path": "/outside/original.md"}
+
+    async def cancel():
+        return None
+
+    monkeypatch.setattr(documents, "choose_markdown_file", cancel)
+    assert client.post("/api/documents/pick").json() == {"path": None}
+    assert list(tmp_path.iterdir()) == []
+
