@@ -0,0 +1,81 @@
+"""Read original Markdown files; never import, annotate, or write them."""
+
+import asyncio
+import sys
+from pathlib import Path
+
+from fastapi import APIRouter, HTTPException, Response
+
+router = APIRouter(prefix="/api/documents")
+WORKSPACE = Path.cwd().resolve()
+MAX_BYTES = 2_000_000
+
+
+def document_path(path: str) -> Path:
+    if not path or len(path) > 4096 or "\x00" in path:
+        raise HTTPException(422, "Enter a Markdown file path")
+    original = Path(path).expanduser()
+    try:
+        target = (WORKSPACE / original).resolve()
+        if not original.is_absolute() and not target.is_relative_to(WORKSPACE):
+            raise HTTPException(403, "Relative paths must stay inside the workspace")
+        if target.suffix.lower() not in {".md", ".markdown"}:
+            raise HTTPException(422, "Choose a .md or .markdown file")
+        if not target.is_file():
+            raise HTTPException(404, "Markdown file not found")
+        return target
+    except (OSError, ValueError, RuntimeError) as exc:
+        raise HTTPException(422, "Cannot resolve this file path") from exc
+
+
+def read_document(path: str):
+    target = document_path(path)
+    try:
+        with target.open("rb") as source:
+            content = source.read(MAX_BYTES + 1)
+        if len(content) > MAX_BYTES:
+            raise HTTPException(413, "Markdown files must be at most 2 MB")
+        text = content.decode("utf-8")
+    except UnicodeDecodeError as exc:
+        raise HTTPException(422, "Markdown must be UTF-8 text") from exc
+    except OSError as exc:
+        raise HTTPException(422, "Could not read this file") from exc
+    return {"path": str(target), "name": target.name, "content": text}
+
+
+async def choose_markdown_file():
+    if sys.platform != "darwin":
+        raise HTTPException(501, "Native choosing is available on macOS; enter a file path instead")
+    process = await asyncio.create_subprocess_exec(
+        "/usr/bin/osascript",
+        "-e",
+        'try\nset chosen to choose file with prompt "Open a Markdown file"\n'
+        'return POSIX path of chosen\non error number -128\nreturn ""\nend try',
+        stdout=asyncio.subprocess.PIPE,
+        stderr=asyncio.subprocess.PIPE,
+    )
+    try:
+        async with asyncio.timeout(300):
+            stdout, _ = await process.communicate()
+    except (TimeoutError, asyncio.CancelledError):
+        process.kill()
+        await process.wait()
+        raise
+    if process.returncode:
+        raise HTTPException(503, "Could not open the file chooser; enter a file path instead")
+    return stdout.decode("utf-8").rstrip("\r\n") or None
+
+
+@router.post("/pick")
+async def pick_document():
+    try:
+        selected = await choose_markdown_file()
+    except (OSError, TimeoutError) as exc:
+        raise HTTPException(503, "File chooser unavailable; enter a file path instead") from exc
+    return {"path": selected}
+
+
+@router.get("/content")
+def content(path: str, response: Response):
+    response.headers["Cache-Control"] = "no-store"
+    return read_document(path)
