+.chat-pane { display: flex; flex-direction: column; flex: 1; min-width: 0; min-height: 0; }
+.with-document .document-pane { flex: 0 0 var(--reader-width); }
+.document-pane { overflow: auto; min-width: 0; min-height: 0; background: #fffefa; scrollbar-gutter: stable; }
+.reader-status { padding: 12px 24px; font-size: 13px; }
+.pane-resizer { flex: 0 0 9px; background: #e6e7de; cursor: col-resize; touch-action: none; }
+.pane-resizer:hover, .pane-resizer:focus-visible { background: #9cae8c; outline: 2px solid #596f47; outline-offset: -2px; }
+.markdown-document { max-width: 880px; padding: 32px clamp(20px, 3vw, 48px) 80px; margin: auto; font-size: 16px; line-height: 1.8; overflow-wrap: anywhere; }
+.markdown-document h1 { font-size: 36px; }
+.markdown-document h2, .markdown-document h3, .markdown-document h4 { line-height: 1.3; margin-top: 1.6em; }
+.markdown-document a { color: #4d6d38; text-decoration: underline; }
+.markdown-document blockquote { border-left: 3px solid #b6c3a9; margin: 20px 0; padding: 0 20px; color: #737b69; }
+.markdown-document code { font-size: .88em; background: #f0f1e9; padding: 2px 5px; border-radius: 4px; }
+.markdown-document pre { overflow: auto; max-width: 100%; padding: 16px; background: #f0f1e9; line-height: 1.6; border-radius: 8px; }
+.markdown-document pre code { padding: 0; white-space: pre; overflow-wrap: normal; }
+.markdown-document table { display: block; overflow: auto; max-width: 100%; border-collapse: collapse; font-size: 14px; }
+.markdown-document td, .markdown-document th { border: 1px solid #dce1d3; padding: 8px 12px; }
+.markdown-document hr { border: 0; border-top: 1px solid #dce1d3; margin: 28px 0; }
+.document-picker { width: min(540px, calc(100% - 32px)); max-height: 90dvh; overflow: auto; padding: 24px; border: 1px solid #dce1d3; border-radius: 16px; color: inherit; background: #fffefa; }
+.document-picker::backdrop { background: #292e2966; }
+.document-picker h2 { margin-top: 0; font-size: 20px; }
+.document-picker p { font-size: 13px; line-height: 1.6; }
+.document-picker form { display: flex; flex-direction: column; align-items: stretch; padding: 0; border: 0; box-shadow: none; background: none; }
+.document-picker label { font-size: 13px; }
+.document-picker input { font: inherit; width: 100%; border: 1px solid #9cae8c; border-radius: 6px; padding: 10px; background: white; }
+.picker-actions { display: flex; flex-wrap: wrap; gap: 8px; }
+.with-document .footnote span:last-child { display: none; }
+@media (max-width: 800px) {
+  .workspace.with-document { flex-direction: column; overflow-y: auto; }
+  .with-document .document-pane { flex: 0 0 45%; min-height: 180px; border-bottom: 1px solid #dce1d3; }
+  .with-document .chat-pane { flex: 1 0 50%; min-height: 300px; }
+  .pane-resizer { display: none; }
+  .reader-bar { padding: 8px 16px; gap: 6px; flex-wrap: wrap; }
+  .reader-bar .quiet-button { padding: 6px 8px; }
+  .reader-path { order: 4; flex-basis: 100%; }
+  .markdown-document { padding: 20px; }
+}
