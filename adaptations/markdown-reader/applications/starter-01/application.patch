diff --git a/tests/markdown.test.ts b/tests/markdown.test.ts
new file mode 100644
index 0000000..c82a40b
--- /dev/null
+++ b/tests/markdown.test.ts
@@ -0,0 +1,38 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { JSDOM } from 'jsdom';
+
+const dom = new JSDOM('');
+Object.assign(globalThis, { window: dom.window, document: dom.window.document });
+// DOMPurify needs a DOM at module initialization.
+const { renderMarkdown } = await import('../frontend/markdown.ts');
+
+function render(text: string) {
+  const element = document.createElement('div');
+  element.innerHTML = renderMarkdown(text);
+  return element;
+}
+
+test('renders readable Markdown including tables and code', () => {
+  const root = render('# Heading\n\nParagraph **bold**.\n\n- item\n\n> quote\n\n```js\nconst x = 1;\n```\n\n| A | B |\n|---|---|\n| x | y |');
+  for (const tag of ['h1', 'p', 'strong', 'li', 'blockquote', 'pre', 'code', 'table', 'th', 'td']) {
+    assert.ok(root.querySelector(tag), tag);
+  }
+});
+
+test('untrusted documents cannot execute or automatically load resources', () => {
+  const root = render(`<script>alert(1)</script><style>@import 'https://evil.test';</style>
+<img src="https://evil.test/pixel"><svg><image href="https://evil.test/svg" /></svg>
+<iframe src="https://evil.test"></iframe><video poster="https://evil.test/poster"></video>
+<link rel="stylesheet" href="https://evil.test/css"><object data="https://evil.test/object"></object>
+<p style="background:url(https://evil.test)" onclick="alert(1)" id="spoof">Text</p>
+<a href="javascript:alert(1)">bad</a><a href="file:///etc/passwd">file</a>
+<a href="/api/chat">relative</a><a href="https://example.com" ping="https://evil.test">safe</a>
+![Markdown image](https://evil.test/image)`);
+  assert.equal(root.querySelector('script,style,img,svg,iframe,video,link,object'), null);
+  assert.equal(root.querySelector('[onclick],[style],[id],[ping],[src]'), null);
+  const links = [...root.querySelectorAll('a')];
+  assert.deepEqual(links.map(link => link.getAttribute('href')), [null, null, null, 'https://example.com']);
+  assert.equal(links[3].getAttribute('rel'), 'noopener noreferrer');
+  assert.equal(links[3].getAttribute('target'), '_blank');
+});
