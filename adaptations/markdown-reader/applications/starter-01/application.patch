+def test_hostile_origins_cannot_read_or_choose(client):
+    for method, route in [
+        ("GET", "/api/documents/content?path=README.md"),
+        ("POST", "/api/documents/pick"),
+    ]:
+        assert (
+            client.request(method, route, headers={"Origin": "https://evil.test"}).status_code
+            == 403
+        )
